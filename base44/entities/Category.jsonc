{
  "name": "Category",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Kode kategori unik, mis. Jamu"
    },
    "label_id": {
      "type": "string",
      "description": "Nama kategori (Indonesia)"
    },
    "label_en": {
      "type": "string",
      "description": "Category name (English)"
    },
    "icon": {
      "type": "string",
      "default": "\ud83c\udf31",
      "description": "Emoji ikon kategori"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Urutan tampil"
    }
  },
  "required": [
    "key",
    "label_id"
  ]
}