{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Reference to the reviewed Product id"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating 1-5"
    },
    "name": {
      "type": "string",
      "description": "Reviewer display name"
    },
    "comment": {
      "type": "string",
      "description": "Review text"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Disetujui admin untuk tampil publik"
    }
  },
  "required": [
    "product_id",
    "rating",
    "name",
    "comment"
  ]
}